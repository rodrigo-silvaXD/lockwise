# Copie para .env (nao versionado) ou exporte no ambiente. Nunca commite valores reais.

# Render entrega postgres://...; localmente, SQLite em arquivo:
DATABASE_URL=sqlite:///./lockwise.db

# Obrigatoria para escrever. Gere uma: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Aceita varias separadas por virgula — uma por origem, para que a de um
# simulador publico possa ser revogada sozinha (ADR 0029):
#   LOCKWISE_API_KEY=chave-do-gateway,chave-do-simulador
LOCKWISE_API_KEY=troque-esta-chave

# limite | horario | composta | nenhuma
LOCKWISE_POLITICA=composta
LOCKWISE_LIMITE_TENTATIVAS=2
LOCKWISE_JANELA=06:00-23:00
LOCKWISE_FUSO=America/Sao_Paulo

# Opcional: webhook (Discord/Telegram/Slack) avisado a cada alerta
# LOCKWISE_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Origens do painel, separadas por virgula
LOCKWISE_CORS_ORIGINS=*
